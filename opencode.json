{
  "$schema": "https://opencode.ai/config.json",
  // REMOVED: "notifications": false
  // That key does not exist in the opencode.json schema ($defs.Config declares
  // additionalProperties: false and has no "notifications" property), and
  // ConfigParse.schema decodes with onExcessProperty:"ignore" — so it was parsed,
  // silently thrown away, and never did anything. TUI attention/notifications are
  // configured in tui.json instead:
  //   { "$schema": "https://opencode.ai/tui.json", "attention": { "enabled": false } }
  // ("attention" is already disabled by default.) Desktop notifications, terminal
  // title, and cmux status remain driven separately by profiles/ws/plugins/notify.ts
  // via kdco-notify.json.
  "default_agent": "build",
  // "shell" — MISSING until now. On Windows the bash tool falls back to %COMSPEC%
  // (cmd.exe) and shell mode (!) falls back to process.env.SHELL ?? "bash", which is
  // why "shell" and "bash" behave erratically: if SHELL is unset it tries to spawn a
  // bare `bash` that usually is not on PATH, and if SHELL points at WSL bash the
  // Windows environment (PATH, npm, python...) is not inherited.
  // Verify your bash path with `where bash` in cmd, then uncomment ONE of these:
  // "shell": "C:\\Program Files\\Git\\bin\\bash.exe",
  // "shell": "pwsh",
  // Equivalent env override: OPENCODE_GIT_BASH_PATH
  // SINGLE SOURCE OF TRUTH for agent capabilities.
  // This top-level block is the default policy for EVERY agent. A per-agent
  // `permission` block overrides it; an agent's `tools` block only decides whether
  // a tool is exposed at all. Both layers must agree, so keep them consistent:
  //   tools.bash = false -> bash hidden regardless of permission
  //   tools.bash = true  -> bash visible, gated by the permission rules below
  // Read-only research agents should set tools.bash = false and rely on glob/grep/read.
  // The profiles/ws overlay applies tighter per-role allowlists (plan/build/coder/
  // explore/researcher); those are deliberately stricter and are the intended policy
  // when running under that profile.
  //
  // The note above USED to be a JSON key: "_comment": [ ...array of strings... ].
  // That is illegal. PermissionConfig is StructWithRest(Struct({...known keys...}),
  // [Record(String, PermissionRuleConfig)]) -- every extra key must be "ask"|"allow"|"deny"
  // or an object of pattern -> action. An array is neither, so the whole file failed to
  // decode. `opencode debug config` reports:
  //   Configuration is invalid at .../opencode.json
  //   ↳ Expected PermissionRuleConfig, got [...] permission._comment
  // Keep notes like this as // comments, never as JSON keys.
  "permission": {
    "bash": {
      "*": "ask",
      "rm *": "deny",
      "rmdir *": "deny",
      "del *": "deny",
      "Remove-Item *": "deny",
      "format *": "deny",
      "mkfs*": "deny",
      "dd *": "deny",
      "reg delete*": "deny",
      "git push*": "ask",
      "git reset --hard*": "ask",
      "git clean*": "ask"
    },
    "webfetch": "allow",
    "mcp_*": "ask"
  },
  "instructions": [
    "AGENTS.md",
    "CONTRIBUTING.md",
    "instructions/INSTRUCTIONS.md",
