    "opencode-hooks-plugin",
    "opencode-host-notify-bridge",
    "opencode-ignore",
    "opencode-kilo-auth",
    "opencode-litellm",
    "opencode-log-sanitizer",
    "opencode-mem",
    // DISABLED on Windows — this is the main source of stray words appearing in the TUI.
    // Its init runs `tmuxAvailable = await isTmuxAvailable()` and, with NO process.platform
    // guard, calls console.warn("[Mission Control] tmux is not installed or not in PATH...")
    // straight into the terminal every time a session starts. Its monitor/reconcile loops add
    // ~27 more unguarded console.warn/console.error calls that fire mid-session.
    // tmux is not available on Windows. Re-enable only if you run opencode under WSL/tmux.
    // "opencode-mission-control",
    "opencode-models-discovery",
    "opencode-mystatus",
    "opencode-notify",
    "opencode-ntfy.sh",
    "opencode-omniroute-auth",
    "opencode-openai-codex-auth",
    "opencode-personality",
    "opencode-plan-manager",
    "opencode-plugin-openspec",
    "opencode-pr-signature",
    "opencode-ralph-wiggum",
    "opencode-research-papers",
    "opencode-semantic-anchors",
    "opencode-sessions",
    // DISABLED — THIS was the "words appearing in the interface" glitch.
    // Its send() is `if (platform === "darwin") { osascript } else { dbus-send }` — the
    // else branch is "not macOS", NOT "Linux". On Windows it runs
    //   $`dbus-send --session --dest=org.freedesktop.Notifications ...`
    // through opencode's injected Bun shell, and Windows has no dbus-send, so the shell
    // prints "bun: command not found" into the TUI. It fires on session.idle,
    // session.error, permission.asked AND tool.execute.before(question) — i.e.
    // repeatedly mid-session — and the `catch {}` swallows the rejection, so all you
    // see is the stray shell text. Useless on Windows anyway.
    // "opencode-simple-notify",
    "opencode-smart-title",
    "opencode-smart-voice-notify",
    "opencode-snip",
    "opencode-snippets",
    "opencode-synced",
    "opencode-system-prompt-logger",
    "opencode-telemetry",
    "opencode-token-tracker",
    "opencode-tts",
    "opencode-update-notifier",
    "opencode-usage-monitor",
    "opencode-wakatime",
    "opencode-workaholic",
    "opencode-worktree-memory-sync",
    // DISABLED on Windows — shells out to `zellij` with zero process.platform checks
    // (verified: no "win32" guard anywhere in its dist), so it errors and writes to the
    // terminal. Re-enable only under WSL/zellij.
    // "opencode-zellij-namer",
    "open-dynamic-workflows",
    "open-plan-annotator"
  ],
  "provider": {
    "google": {
      // "npm" tells opencode which AI SDK package backs this provider. The
      // opencode-antigravity-auth README lists this as the fix for "Gemini Model
      // Not Found" / "Unknown name 'parameters'" 400s.
      "npm": "@ai-sdk/google",
      // IMPORTANT: do NOT set options.baseURL / options.apiKey here. The
      // opencode-antigravity-auth plugin owns the "google" provider and talks to
      // https://cloudcode-pa.googleapis.com/v1internal:streamGenerateContent itself.
      // Pointing google at https://generativelanguage.googleapis.com/v1beta routes the
      // antigravity-* models to the public Gemini API, which does not know those IDs.
      "models": {
        "antigravity-gemini-3-pro": {
          "name": "Gemini 3 Pro (Antigravity)",
          "limit": { "context": 1048576, "output": 65535 },
          "modalities": { "input": ["text", "image", "pdf"], "output": ["text"] },
          "variants": {
            "low": { "thinkingLevel": "low" },
            "high": { "thinkingLevel": "high" }
          }
        },
