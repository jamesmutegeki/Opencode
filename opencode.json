{
  "$schema": "https://opencode.ai/config.json",
  "notifications" : false, // Disables opencode's built-in TUI toast ONLY. Desktop notifications,
                          // terminal title, and cmux status are driven separately by
                          // profiles/ws/plugins/notify.ts, configured in kdco-notify.json.
                          // See kdco-notify.json for the authoritative notify settings.
  "default_agent": "build",
  "permission": {
    "_comment": [
      "SINGLE SOURCE OF TRUTH for agent capabilities.",
      "This top-level block is the default policy for EVERY agent. A per-agent",
      "`permission` block overrides it; an agent's `tools` block only decides whether",
      "a tool is exposed at all. Both layers must agree, so keep them consistent:",
      "  tools.bash = false -> bash hidden regardless of permission",
      "  tools.bash = true  -> bash visible, gated by the permission rules below",
      "Read-only research agents should set tools.bash = false and rely on glob/grep/read.",
      "The profiles/ws overlay applies tighter per-role allowlists (plan/build/coder/",
      "explore/researcher); those are deliberately stricter and are the intended policy",
      "when running under that profile."
    ],
    "bash": {
      "*": "ask",
      "rm *": "deny",
      "rmdir *": "deny",
      "del *": "deny",
      "Remove-Item *": "deny",
      "format *": "deny",
      "mkfs*": "deny",
      "dd *": "deny",
      "reg delete*": "deny",
      "git push*": "ask",
      "git reset --hard*": "ask",
      "git clean*": "ask"
    },
    "webfetch": "allow"
  },
  "instructions": [
    "AGENTS.md",
    "CONTRIBUTING.md",
    "instructions/INSTRUCTIONS.md",
    "instructions/apify-routing.md",
    "skills/tdd-workflow/SKILL.md",
    "skills/security-review/SKILL.md",
    "skills/coding-standards/SKILL.md",
    "skills/frontend-patterns/SKILL.md",
    "skills/frontend-slides/SKILL.md",
    "skills/backend-patterns/SKILL.md",
    "skills/e2e-testing/SKILL.md",
    "skills/verification-loop/SKILL.md",
    "skills/api-design/SKILL.md",
    "skills/strategic-compact/SKILL.md",
    "skills/eval-harness/SKILL.md"
  ],
  "skills": {
    "paths": [
      "../skills"
    ]
  },
  "agent": {
    "build": {
      "description": "Primary coding agent for development work",
      "mode": "primary",
      "tools": {
        "write": true,
        "edit": true,
        "bash": true,
        "read": true,
        "changed-files": true,
        "workflow": true
      }
    },
    "apify": {
      "description": "Apify specialist for web scraping, browser automation, and data extraction. Routes every Apify request to the right skill, MCP tool, or CLI workflow.",
      "mode": "subagent",
      "prompt": "{file:prompts/agents/apify.txt}"
    },
    "planner": {
      "description": "Expert planning specialist for complex features and refactoring. Use for implementation planning, architectural changes, or complex refactoring.",
      "mode": "subagent",
      "prompt": "{file:prompts/agents/planner.txt}",
      "tools": {
        "read": true,
        "bash": true,
        "write": true,
        "edit": true
      }
    },
    "architect": {
      "description": "Software architecture specialist for system design, scalability, and technical decision-making.",
      "mode": "subagent",
      "prompt": "{file:prompts/agents/architect.txt}",
      "tools": {
        "read": true,
        "bash": true,
        "write": false,
        "edit": false
      }
    },
    "code-reviewer": {
      "description": "Expert code review specialist. Reviews code for quality, security, and maintainability. Use immediately after writing or modifying code.",
      "mode": "subagent",
      "prompt": "{file:prompts/agents/code-reviewer.txt}",
      "tools": {
        "read": true,
        "bash": true,
        "write": false,
        "edit": false
      }
    },
    "security-reviewer": {
      "description": "Security vulnerability detection and remediation specialist. Use after writing code that handles user input, authentication, API endpoints, or sensitive data.",
      "mode": "subagent",
      "prompt": "{file:prompts/agents/security-reviewer.txt}",
      "tools": {
        "read": true,
        "bash": true,
        "write": true,
        "edit": true
      }
    },
    "tdd-guide": {
      "description": "Test-Driven Development specialist enforcing write-tests-first methodology. Use when writing new features, fixing bugs, or refactoring code. Ensures 80%+ test coverage.",
      "mode": "subagent",
      "prompt": "{file:prompts/agents/tdd-guide.txt}",
      "tools": {
        "read": true,
        "write": true,
        "edit": true,
        "bash": true
      }
    },
    "build-error-resolver": {
      "description": "Build and TypeScript error resolution specialist. Use when build fails or type errors occur. Fixes build/type errors only with minimal diffs.",
      "mode": "subagent",
      "prompt": "{file:prompts/agents/build-error-resolver.txt}",
      "tools": {
        "read": true,
        "write": true,
        "edit": true,
        "bash": true
      }
    },
    "e2e-runner": {
      "description": "End-to-end testing specialist using Playwright. Generates, maintains, and runs E2E tests for critical user flows.",
      "mode": "subagent",
      "prompt": "{file:prompts/agents/e2e-runner.txt}",
      "tools": {
        "read": true,
        "write": true,
        "edit": true,
        "bash": true
      }
    },
    "doc-updater": {
      "description": "Documentation and codemap specialist. Use for updating codemaps and documentation.",
      "mode": "subagent",
      "prompt": "{file:prompts/agents/doc-updater.txt}",
      "tools": {
        "read": true,
        "write": true,
        "edit": true,
        "bash": true
      }
    },
    "refactor-cleaner": {
      "description": "Dead code cleanup and consolidation specialist. Use for removing unused code, duplicates, and refactoring.",
      "mode": "subagent",
      "prompt": "{file:prompts/agents/refactor-cleaner.txt}",
      "tools": {
        "read": true,
        "write": true,
        "edit": true,
        "bash": true
      }
    },
    "go-reviewer": {
      "description": "Expert Go code reviewer specializing in idiomatic Go, concurrency patterns, error handling, and performance.",
      "mode": "subagent",
      "prompt": "{file:prompts/agents/go-reviewer.txt}",
      "tools": {
        "read": true,
        "bash": true,
        "write": false,
        "edit": false
      }
    },
    "go-build-resolver": {
      "description": "Go build, vet, and compilation error resolution specialist. Fixes build errors with minimal changes.",
      "mode": "subagent",
      "prompt": "{file:prompts/agents/go-build-resolver.txt}",
      "tools": {
        "read": true,
        "write": true,
        "edit": true,
        "bash": true
      }
    },
    "database-reviewer": {
      "description": "PostgreSQL database specialist for query optimization, schema design, security, and performance. Incorporates Supabase best practices.",
