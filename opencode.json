  // NOTE: the second top-level "permission" block that used to live here was DELETED.
  // JSONC keeps only the LAST duplicate key, so that block was silently replacing the
  // "permission" block at the top of this file and wiping out permission.bash and
  // permission.webfetch entirely. Everything it wanted is now merged into the single
  // "permission" block at the top of the file. Do not re-add a second one.
  //
  // "workflow" / "workflows" / "tools" were also dropped: they are not real permission
  // names (see PermissionConfig in https://opencode.ai/config.json), so they matched no
  // rule and did nothing.
  "plugin": [
    "C:\\Users\\james\\.config\\opencode\\node_modules\\opencode-antigravity-auth",
    "@bluelovers/opencode-arise",
    "envsitter-guard",
    "harness-memory",
    "micode",
    "oh-my-opencode-slim",
    "opencode-adaptive-thinking",
    "opencode-agent-memory",
